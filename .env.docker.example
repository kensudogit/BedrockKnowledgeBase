# Docker Compose 用（コピー: copy .env.docker.example .env）
# compose が DATABASE_URL / DYNAMODB / LocalStack を上書きします。

APP_ENV=development
AWS_REGION=ap-northeast-1
CORS_ORIGINS=http://localhost:3010
USE_BEDROCK_MOCK=true
REQUIRE_API_KEY=false

# ローカル Docker ログイン（/login → 開発 JWT）。16文字以上推奨
JWT_SECRET=docker-dev-jwt-secret-change-me

# Cognito 利用時のみ（Terraform apply 後）
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_DOMAIN_PREFIX=
COGNITO_ISSUER=

OPENAI_API_KEY=
ENABLE_GUARDRAILS=true
ENABLE_AGENTS=true
ENABLE_TELEMETRY=true

# ブラウザからの PKCE リダイレクト（ホスト側 URL のまま）
NEXT_PUBLIC_APP_URL=http://localhost:3010
