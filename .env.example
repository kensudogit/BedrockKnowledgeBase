# App
# Railway: APP_ENV=production · CORS_ORIGINS=* · INTERNAL_API_URL=http://127.0.0.1:8180
APP_ENV=development
AWS_REGION=ap-northeast-1
CORS_ORIGINS=http://localhost:3010,*
# Container internal API (must match start.sh uvicorn :8180). Do NOT use :8290 on Railway.
INTERNAL_API_URL=http://127.0.0.1:8180
NEXT_PUBLIC_API_URL=
PORT=8180

# Auth
API_KEYS=
REQUIRE_API_KEY=false
# Railway Shared Variable — used by POST /api/auth/token and Bearer JWT
JWT_SECRET=

# LLM providers
# Railway: set OPENAI_API_KEY to use Chat Completions when Bedrock mock is on
OPENAI_API_KEY=
OPENAI_TEXT_MODEL_ID=gpt-4o-mini

# Data stores
# Railway Postgres injects DATABASE_URL automatically (postgres:// is normalized)
DATABASE_URL=postgresql://bkb_user:bkb_password@localhost:5435/bkb_db
# Local only. Railway: leave empty (memory fallback or AWS DynamoDB)
DYNAMODB_ENDPOINT=
DYNAMODB_TABLE_PROMPTS=bkb_prompts
DYNAMODB_TABLE_EVALS=bkb_evals
DYNAMODB_TABLE_SESSIONS=bkb_sessions

# Amazon Bedrock (optional if OPENAI_API_KEY is set for text)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_TEXT_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_IMAGE_MODEL_ID=amazon.titan-image-generator-v1
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_KNOWLEDGE_BASE_ID=
BEDROCK_DATA_SOURCE_ID=
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT
BEDROCK_AGENT_ID=
BEDROCK_AGENT_ALIAS_ID=
S3_DOCUMENTS_BUCKET=

# Google Cloud / Vertex AI (optional)
# Prefer Vertex over OpenAI when PREFER_VERTEX=true and GCP_PROJECT_ID is set
GCP_PROJECT_ID=
GCP_REGION=asia-northeast1
GCP_ACCESS_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_TEXT_MODEL_ID=gemini-2.0-flash-001
GCS_DOCUMENTS_BUCKET=
USE_VERTEX_MOCK=true
PREFER_VERTEX=false

# Feature flags
USE_BEDROCK_MOCK=true
ENABLE_GUARDRAILS=true
ENABLE_AGENTS=true
ENABLE_TELEMETRY=true
EVAL_FAIL_UNDER=0.0
