# App
APP_ENV=development
AWS_REGION=ap-northeast-1
CORS_ORIGINS=http://localhost:3010
INTERNAL_API_URL=http://localhost:8180
NEXT_PUBLIC_API_URL=
PORT=8180

# Local data stores
DATABASE_URL=postgresql://bkb_user:bkb_password@localhost:5435/bkb_db
DYNAMODB_ENDPOINT=http://localhost:8001
DYNAMODB_TABLE_PROMPTS=bkb_prompts
DYNAMODB_TABLE_EVALS=bkb_evals
DYNAMODB_TABLE_SESSIONS=bkb_sessions

# Amazon Bedrock (leave empty to use local mock mode)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_TEXT_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_IMAGE_MODEL_ID=amazon.titan-image-generator-v1
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_KNOWLEDGE_BASE_ID=
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT
BEDROCK_AGENT_ID=
BEDROCK_AGENT_ALIAS_ID=
S3_DOCUMENTS_BUCKET=

# Feature flags
USE_BEDROCK_MOCK=true
ENABLE_GUARDRAILS=true
ENABLE_AGENTS=true
